{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "ZENIT_ALLOW_LOCAL_HTTP": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "ZENIT_ALLOW_LOCAL_HTTP": "1"
      },
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true
    }
  }
}
