ADMIN_KEY=generar-una-clave-larga-y-aleatoria
# Contraseña corta de administración (mínimo 8 caracteres) para ingresar con el usuario «admin».
ADMIN_PASSWORD=
# Opcional: clave de escaneo compartida. Si se deja vacía, solo entran los usuarios de escaneo creados desde la app.
SCANNER_KEY=
MAX_SCANNER_USERS=3
EVENT_CAPACITY=84
# SQLite para desarrollo (solo una instancia):
DATABASE_PATH=zenit.sqlite3
# PostgreSQL para despliegue con varios procesos:
# DATABASE_URL=postgresql+psycopg://usuario:clave@host:5432/zenit
# CORS_ORIGINS=*
