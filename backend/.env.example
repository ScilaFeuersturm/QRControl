ADMIN_KEY=generar-una-clave-larga-y-aleatoria
# Contraseña corta de administración (mínimo 8 caracteres) para ingresar con el usuario «admin».
ADMIN_PASSWORD=
# Opcional: clave de escaneo compartida. Si se deja vacía, solo entran los usuarios de escaneo creados desde la app.
MAX_SCANNER_USERS=3
DATABASE_PATH=qrcontrol.sqlite3
# DATABASE_URL=postgresql+psycopg://usuario:clave@host:5432/qrcontrol?sslmode=require
BRAND_NAME=QRControl
MAX_ACTIVE_EVENTS=2
EVENT_CAPACITY=100
# Opcional: precargar un evento al iniciar una base vacía.
# INITIAL_EVENT_NAME=Mi evento
# INITIAL_EVENT_DATE=Fecha y horario
# INITIAL_EVENT_VENUE=Lugar
# TICKET_ACCENT_COLOR=#93D5C9
# CORS_ORIGINS=*
